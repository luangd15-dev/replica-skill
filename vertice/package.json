{
  "name": "vertice",
  "version": "0.3.0",
  "description": "Projeto el\u00e9trico predial com planta 2D e vista 3D",
  "main": "main.js",
  "scripts": {
    "bundle": "esbuild src/app.js --bundle --format=iife --minify --loader:.dxf=text --outfile=src/bundle.js",
    "start": "npm run bundle && electron .",
    "test": "node --test tests/*.test.mjs",
    "dist:win": "node scripts/baixar-libredwg.mjs && npm run bundle && electron-builder --win --x64",
    "libredwg": "node scripts/baixar-libredwg.mjs"
  },
  "author": "V\u00e9rtice",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.23.1"
  },
  "dependencies": {
    "three": "^0.168.0"
  },
  "productName": "V\u00e9rtice",
  "build": {
    "appId": "app.vertice.desktop",
    "productName": "Vertice",
    "files": [
      "main.js",
      "preload.js",
      "src/index.html",
      "src/styles.css",
      "src/bundle.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Vertice-${version}-portatil.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Vertice-${version}-instalador.exe"
    },
    "publish": null,
    "extraResources": [
      {
        "from": "vendor/libredwg",
        "to": "libredwg"
      }
    ]
  }
}
